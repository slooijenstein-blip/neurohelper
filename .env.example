# Clerk — copy to `.env.local` and fill in from https://dashboard.clerk.com
# Never commit real keys. The publishable key is safe to expose in the browser;
# the secret key must stay server-side only.

# Required for sign-in in the Vite app (npm run dev / npm run preview)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Server-only. Do not prefix with VITE_ — Vite would bake it into the client bundle.
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# Optional. The app also computes these from Vite BASE_URL (important on GitHub Pages).
# VITE_CLERK_SIGN_IN_URL=/sign-in
# VITE_CLERK_SIGN_UP_URL=/sign-up

# --- Optional Supabase (shared schedule persistence) ---
# The Calendar prototype ships with a local demo store so Vercel preview stays
# clickable without configuring Supabase. When these are set, a future build can
# sync children / library / day plans / invites. Leave blank for prototype mode.
#
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=  # server only — never prefix with VITE_
