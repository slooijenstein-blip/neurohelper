# Clerk — copy to `.env.local` and fill in from https://dashboard.clerk.com
# Never commit real keys. The publishable key is safe to expose in the browser;
# the secret key must stay server-side only (unused by this static SPA today).

# Required for sign-in in the Vite app (npm run dev / npm run preview)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Server-only. Do not prefix with VITE_ — Vite would bake it into the client bundle.
# Required on the Vercel preview so /api/share can verify sessions and send
# Clerk invitation emails. Never commit a real value. Do not point this at production.
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# Durable store for patients, invites, and shared plans. Use either pair.
# Vercel → Storage → Create Upstash Redis (or KV) and connect it to this project.
# Vercel fills these in. Do not commit the real URL or token.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
# KV_REST_API_URL and KV_REST_API_TOKEN are accepted as aliases.

# Optional. Comma-separated Profile inboxes for Pro requests waiting.
# When unset, both samlooijenstein@gmail.com and s.looijenstein@synlumae.com
# can open that list. Setting this replaces the built-in list on the server.
# PRO_REQUEST_ADMIN_EMAILS=s.looijenstein@synlumae.com,samlooijenstein@gmail.com

# Optional. Same list, baked into the Profile UI at build time. Leave unset to
# use the built-in addresses. Set this together with PRO_REQUEST_ADMIN_EMAILS
# when you replace the list.
# VITE_PRO_REQUEST_ADMIN_EMAILS=s.looijenstein@synlumae.com,samlooijenstein@gmail.com

# Optional. Intended notify address for a new Pro request. No general mailer
# is wired, so the request is saved and listed on Profile for the reviewer
# addresses above. Setting this does not send mail by itself.
# PRO_REQUEST_NOTIFY_EMAIL=s.looijenstein@synlumae.com

# Optional. Extra origins allowed inside Clerk session tokens (azp).
# Leave unset unless verifyToken rejects the preview host.
# CLERK_AUTHORIZED_PARTIES=http://localhost:8080,https://your-preview.vercel.app

# Optional. The app also computes these from Vite BASE_URL (important on GitHub Pages).
# VITE_CLERK_SIGN_IN_URL=/sign-in
# VITE_CLERK_SIGN_UP_URL=/sign-up
